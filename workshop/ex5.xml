<mujoco model="3-joint-planar-manipulator">
    <option timestep = "0.000001"/>
    <default>
        <joint axis="0 1 0"/>
        <geom type="capsule" size=".01" rgba=".9 .7 .1 1"/>
        <default class="visual_cylinder">
            <geom type="cylinder" fromto="0 .015 0 0 -.015 0" size=".02" rgba=".3 .9 .3 .4"/>
        </default>
    </default>
    <worldbody>
        <light pos="0 0 1"/>
        <body name = 'l1' pos="0 0 0">
            <joint name = 'q1' damping = '0.005'/>
            <geom name="g1" class="visual_cylinder"/>
            <geom name = 'l1' fromto="0 0 0 .1 0 0"/>
            <body name = 'l2' pos=".1 0 0">
                <joint name = 'q2' damping = '0.005'/>
                <geom name="g2" class="visual_cylinder"/>
                <geom name = 'l2' fromto="0 0 0 .1 0 0"/>
                <body name = 'l3' pos=".1 0 0">
                    <joint name = 'q3' damping = '0.005'/>
                    <geom name="g3" class="visual_cylinder"/>
                    <geom name = 'l3' fromto="0 0 0 .1 0 0"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
		<position name="pos_q1" joint="q1" ctrllimited="true" ctrlrange="-3.14 3.14" kp="200" kv="1"/>  
		<position name="pos_q2" joint="q2" ctrllimited="true" ctrlrange="-3.14 3.14" kp="200" kv="1"/>  
		<position name="pos_q3" joint="q3" ctrllimited="true" ctrlrange="-3.14 3.14" kp="200" kv="1"/>  
    </actuator>
</mujoco>